# API base URL (no trailing slash)
VITE_API_BASE_URL=https://fit.damtowise.xyz

# Application API key — sent as x-api-key on EVERY request (identifies this frontend app).
# After a user signs in, their JWT is also sent as Authorization: Bearer … on user-scoped calls (see AuthContext).
VITE_API_KEY=your-api-key-from-backend-seed-or-applications-table

# Public site URL for canonical links & JSON-LD (no trailing slash)
VITE_SITE_URL=https://fit.damtowise.xyz

# Sign-in: magic link is the default screen; users can switch to password. Set to false if magic link is not set up.
# VITE_MAGIC_LINK_LOGIN=false

# --- Backend (.env) — not used by Vite; set on the API server for Resend email links ---
# MAGIC_LINK_REDIRECT_URL=https://fit.damtowise.xyz/auth/magic-link
# EMAIL_CONFIRMATION_REDIRECT_URL=https://fit.damtowise.xyz/auth/email-confirmation
